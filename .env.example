# PixelForge - configuration. Copiez ce fichier en ".env" (a la racine du projet, ou dans backend/)
# et decommentez les lignes a modifier. Les valeurs ci-dessous sont les valeurs par defaut.

# Adresse de ComfyUI.
# PIXELFORGE_COMFY_URL=http://127.0.0.1:8188

# Dossier ou sont stockes projets, images et exports (relatif au dossier de lancement du backend).
# PIXELFORGE_DATA_DIR=data

# Modeles (noms de fichiers tels qu'ils apparaissent dans ComfyUI).
# PIXELFORGE_CHECKPOINT=sd_xl_base_1.0.safetensors
# PIXELFORGE_LORA=pixel-art-xl.safetensors
# PIXELFORGE_LORA_STRENGTH=1.0
# PIXELFORGE_CONTROLNET_OPENPOSE=controlnet-openpose-sdxl-1.0.safetensors

# Preset du noeud IPAdapterUnifiedLoader (ComfyUI_IPAdapter_plus).
# Avec un checkpoint SD 1.5 : "PLUS (high strength)" reste valable, mais le modele ip-adapter-plus_sd15
# doit etre present. Voir docs/setup-comfyui.md.
# PIXELFORGE_IPADAPTER_PRESET=PLUS (high strength)

# Cote (en pixels) du canevas de la grille de poses envoyee a ComfyUI.
# Reduire a 768 si la memoire video (8 Go) est insuffisante.
# PIXELFORGE_GRID_CANVAS=1024

# Mode demo : remplace ComfyUI par un faux generateur (aucun GPU requis). Valeurs : 1 / 0.
# PIXELFORGE_FAKE_COMFY=0

# Origines autorisees par le CORS : DOIT etre une liste JSON.
# PIXELFORGE_CORS_ORIGINS=["http://localhost:5173"]
